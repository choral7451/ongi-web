# artinfo-server 주소 (미설정 시 운영 서버)
NEXT_PUBLIC_API_URL=https://api-artinfokorea.com
# Google Cloud 콘솔의 "웹 애플리케이션" OAuth 클라이언트 ID (승인된 JavaScript 원본에 사이트 주소 등록 필요)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 토큰 없는 개발용 로그인 버튼 노출 (서버에 ONGI_DEV_LOGIN=true 가 있을 때만 동작)
NEXT_PUBLIC_DEV_LOGIN=false
# Google Ads 태그 ID (광고 계정 > 목표 > 전환 > Google 태그, 예: AW-123456789). 비우면 태그를 싣지 않는다
NEXT_PUBLIC_GOOGLE_ADS_ID=
# 전환 액션 "앱 다운로드 클릭" 의 전환 라벨 (send_to 의 슬래시 뒤 부분)
NEXT_PUBLIC_GOOGLE_ADS_DOWNLOAD_LABEL=
